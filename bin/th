#!/bin/zsh
# =============================================================================
#  th - Terminal History CLI
#  Interactive picker plus listing, search and delete.
#
#  Usage:
#    th                     Interactive picker (↑/↓ or mouse, Enter = copy)
#    th -l                  Show the last 50 entries
#    th -n 200              Show the last 200 entries
#    th -s "git"            Search for "git"
#    th -d <id>             Delete a single entry
#    th -c                  Clear the whole history
#    th -e <file>           Export history as text
#    th -f <file>           Use a different history file
# =============================================================================

: "${TH_HISTORY_FILE:=$HOME/.terminal_history.jsonl}"

# Remember the script path upfront: inside functions zsh
# (option FUNCTION_ARGZERO) replaces $0 with the function name.
TH_SELF="$0"

FILE="$TH_HISTORY_FILE"
LIMIT=50
SEARCH=""
DELETE_ID=""
CLEAR=0
EXPORT=""
LIST=0

usage() {
  sed -n '2,15p' "$TH_SELF" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# --- Parse arguments ---------------------------------------------------------
while (( $# )); do
  case "$1" in
    -l) LIST=1; shift ;;
    -n)
      if (( $# < 2 )) || [[ "$2" != <-> ]]; then
        echo "th: -n needs a number (e.g. -n 200)." >&2; exit 1
      fi
      LIMIT="$2"; LIST=1; shift 2 ;;
    -s)
      if (( $# < 2 )); then
        echo "th: -s needs a search term." >&2; exit 1
      fi
      SEARCH="$2"; LIST=1; shift 2 ;;
    -d)
      if (( $# < 2 )); then
        echo "th: -d needs an ID." >&2; exit 1
      fi
      DELETE_ID="$2"; shift 2 ;;
    -c) CLEAR=1; shift ;;
    -e)
      if (( $# < 2 )); then
        echo "th: -e needs a filename." >&2; exit 1
      fi
      EXPORT="$2"; shift 2 ;;
    -f)
      if (( $# < 2 )); then
        echo "th: -f needs a filename." >&2; exit 1
      fi
      FILE="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "Unknown option: $1" >&2; usage 1 ;;
  esac
done

[[ -f "$FILE" ]] || { echo "History file not found: $FILE" >&2; exit 1; }

# --- No arguments: interactive picker ----------------------------------------
if (( ! LIST && ! CLEAR )) && [[ -z "$DELETE_ID" && -z "$EXPORT" ]]; then
  exec "$(dirname "$0")/th-pick" "$FILE"
fi

# --- Clear everything --------------------------------------------------------
if (( CLEAR )); then
  read -q "?Really clear the entire history? (y/N) " || { echo; exit 0; }
  echo
  : > "$FILE"
  echo "History cleared."
  exit 0
fi

# --- Delete a single entry ---------------------------------------------------
if [[ -n "$DELETE_ID" ]]; then
  TH_NEEDLE="\"id\":\"$DELETE_ID\""
  if grep -qF -- "$TH_NEEDLE" "$FILE"; then
    grep -vF -- "$TH_NEEDLE" "$FILE" > "$FILE.tmp.$$" && mv "$FILE.tmp.$$" "$FILE"
    echo "Entry $DELETE_ID deleted."
  else
    echo "Entry $DELETE_ID not found." >&2
    exit 1
  fi
  exit 0
fi

# --- Export ------------------------------------------------------------------
if [[ -n "$EXPORT" ]]; then
  if [[ -n "$SEARCH" ]]; then
    grep -iF -- "$SEARCH" "$FILE" > "$EXPORT"
  else
    cp "$FILE" "$EXPORT"
  fi
  echo "Exported to: $EXPORT"
  exit 0
fi

# --- List --------------------------------------------------------------------
# Parse JSONL line by line and print the LAST limit entries formatted
# (chronological: newest entry at the bottom, right above the prompt)
OUTPUT=$(awk -v limit="$LIMIT" -v search="$SEARCH" '
function getval(s, key,   i, start, end, c, val, bs, PH) {
  PH = sprintf("%c", 1)   # placeholder for escaped backslashes (control char \x01)
  i = index(s, "\"" key "\":\"")
  if (i == 0) return ""
  start = i + length(key) + 4
  end = start
  while (end <= length(s)) {
    c = substr(s, end, 1)
    if (c == "\"") {
      # A quote only terminates the string if it is NOT escaped,
      # i.e. preceded by an even number of backslashes (\", \\ matter).
      bs = 0
      while (substr(s, end - bs - 1, 1) == "\\") bs++
      if (bs % 2 == 0) break
    }
    end++
  }
  val = substr(s, start, end - start)
  # JSON unescape: park \\ first, then short escapes, then restore backslash
  gsub(/\\\\/, PH, val)
  gsub(/\\"/, "\"", val)
  gsub(/\\n/, "\n", val)
  gsub(/\\t/, "\t", val)
  gsub(/\\r/, "\r", val)
  gsub(PH, "\\", val)
  return val
}
{
  if ($0 !~ /^\{.*\}$/) next
  # Literal (non-regex) search over the whole line
  if (search != "" && index(tolower($0), tolower(search)) == 0) next

  n++
  ids[n]  = getval($0, "id")
  tss[n]  = getval($0, "ts")
  cwds[n] = getval($0, "cwd")
  cmds[n] = getval($0, "cmd")
  sts[n] = "?"
  if (match($0, /"status":[0-9-]+/)) sts[n] = substr($0, RSTART+9, RLENGTH-9)
}
END {
  first = n - limit + 1
  if (first < 1) first = 1
  for (i = first; i <= n; i++) {
    printf "\033[1;36m%s\033[0m  \033[1;33m%s\033[0m\n", ids[i], tss[i]
    printf "  \033[2m%s\033[0m\n", cwds[i]
    printf "  %s  [status %s]\n", cmds[i], sts[i]
    printf "\n"
  }
}
' "$FILE")

printf '%s' "$OUTPUT"
if [[ -z "$OUTPUT" ]]; then
  echo "No entries found."
fi
