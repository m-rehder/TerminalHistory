#!/bin/zsh
# =============================================================================
#  th – Terminal History CLI
#  Interaktiver Picker + Anzeige, Suche und Löschen.
#
#  Verwendung:
#    th                     Interaktiver Picker (↑/↓ oder Maus, Enter = kopieren)
#    th -l                  Letzte 50 Einträge anzeigen
#    th -n 200              Letzte 200 Einträge anzeigen
#    th -s "git"            Nach "git" suchen
#    th -d <id>             Einzelnen Eintrag löschen
#    th -c                  Komplette History löschen
#    th -e <datei>          History als Text exportieren
#    th -f <datei>          Andere History-Datei verwenden
# =============================================================================

: "${TH_HISTORY_FILE:=$HOME/.terminal_history.jsonl}"

# Skriptpfad vorweg merken: Innerhalb von Funktionen ersetzt zsh
# (Option FUNCTION_ARGZERO) $0 durch den Funktionsnamen.
TH_SELF="$0"

FILE="$TH_HISTORY_FILE"
LIMIT=50
SEARCH=""
DELETE_ID=""
CLEAR=0
EXPORT=""
LIST=0

usage() {
  sed -n '2,15p' "$TH_SELF" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# --- Argumente parsen --------------------------------------------------------
while (( $# )); do
  case "$1" in
    -l) LIST=1; shift ;;
    -n)
      if (( $# < 2 )) || [[ "$2" != <-> ]]; then
        echo "th: -n braucht eine Zahl (z.B. -n 200)." >&2; exit 1
      fi
      LIMIT="$2"; LIST=1; shift 2 ;;
    -s)
      if (( $# < 2 )); then
        echo "th: -s braucht einen Suchbegriff." >&2; exit 1
      fi
      SEARCH="$2"; LIST=1; shift 2 ;;
    -d)
      if (( $# < 2 )); then
        echo "th: -d braucht eine ID." >&2; exit 1
      fi
      DELETE_ID="$2"; shift 2 ;;
    -c) CLEAR=1; shift ;;
    -e)
      if (( $# < 2 )); then
        echo "th: -e braucht einen Dateinamen." >&2; exit 1
      fi
      EXPORT="$2"; shift 2 ;;
    -f)
      if (( $# < 2 )); then
        echo "th: -f braucht einen Dateinamen." >&2; exit 1
      fi
      FILE="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "Unbekannte Option: $1" >&2; usage 1 ;;
  esac
done

[[ -f "$FILE" ]] || { echo "History-Datei nicht gefunden: $FILE" >&2; exit 1; }

# --- Ohne Argumente: interaktiver Picker -------------------------------------
if (( ! LIST && ! CLEAR )) && [[ -z "$DELETE_ID" && -z "$EXPORT" ]]; then
  exec "$(dirname "$0")/th-pick" "$FILE"
fi

# --- Komplett löschen -------------------------------------------------------
if (( CLEAR )); then
  read -q "?Wirklich die komplette History löschen? (j/N) " || { echo; exit 0; }
  echo
  : > "$FILE"
  echo "History gelöscht."
  exit 0
fi

# --- Einzelnen Eintrag löschen ----------------------------------------------
if [[ -n "$DELETE_ID" ]]; then
  TH_NEEDLE="\"id\":\"$DELETE_ID\""
  if grep -qF -- "$TH_NEEDLE" "$FILE"; then
    grep -vF -- "$TH_NEEDLE" "$FILE" > "$FILE.tmp.$$" && mv "$FILE.tmp.$$" "$FILE"
    echo "Eintrag $DELETE_ID gelöscht."
  else
    echo "Eintrag $DELETE_ID nicht gefunden." >&2
    exit 1
  fi
  exit 0
fi

# --- Export ----------------------------------------------------------------
if [[ -n "$EXPORT" ]]; then
  if [[ -n "$SEARCH" ]]; then
    grep -iF -- "$SEARCH" "$FILE" > "$EXPORT"
  else
    cp "$FILE" "$EXPORT"
  fi
  echo "Exportiert nach: $EXPORT"
  exit 0
fi

# --- Anzeigen ---------------------------------------------------------------
# JSONL zeilenweise parsen und die LETZTEN limit Einträge formatiert ausgeben
# (chronologisch: neuster Eintrag unten, direkt über dem Prompt)
OUTPUT=$(awk -v limit="$LIMIT" -v search="$SEARCH" '
function getval(s, key,   i, start, end, c, val, bs, PH) {
  PH = sprintf("%c", 1)   # Platzhalter für escaped Backslashes (Steuerzeichen \x01)
  i = index(s, "\"" key "\":\"")
  if (i == 0) return ""
  start = i + length(key) + 4
  end = start
  while (end <= length(s)) {
    c = substr(s, end, 1)
    if (c == "\"") {
      # Nur eine Quote beendet den String, wenn sie NICHT escaped ist,
      # also eine gerade Anzahl Backslashes davor steht (\"", \\" beachten).
      bs = 0
      while (substr(s, end - bs - 1, 1) == "\\") bs++
      if (bs % 2 == 0) break
    }
    end++
  }
  val = substr(s, start, end - start)
  # JSON-Unescape: erst \\ parken, dann Kurzescapes, dann Backslash zurück
  gsub(/\\\\/, PH, val)
  gsub(/\\"/, "\"", val)
  gsub(/\\n/, "\n", val)
  gsub(/\\t/, "\t", val)
  gsub(/\\r/, "\r", val)
  gsub(PH, "\\", val)
  return val
}
{
  if ($0 !~ /^\{.*\}$/) next
  # Literale (nicht-Regex) Suche über die ganze Zeile
  if (search != "" && index(tolower($0), tolower(search)) == 0) next

  n++
  ids[n]  = getval($0, "id")
  tss[n]  = getval($0, "ts")
  cwds[n] = getval($0, "cwd")
  cmds[n] = getval($0, "cmd")
  sts[n] = "?"
  if (match($0, /"status":[0-9-]+/)) sts[n] = substr($0, RSTART+9, RLENGTH-9)
}
END {
  first = n - limit + 1
  if (first < 1) first = 1
  for (i = first; i <= n; i++) {
    printf "\033[1;36m%s\033[0m  \033[1;33m%s\033[0m\n", ids[i], tss[i]
    printf "  \033[2m%s\033[0m\n", cwds[i]
    printf "  %s  [status %s]\n", cmds[i], sts[i]
    printf "\n"
  }
}
' "$FILE")

printf '%s' "$OUTPUT"
if [[ -z "$OUTPUT" ]]; then
  echo "Keine Einträge gefunden."
fi
