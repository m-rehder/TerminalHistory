#!/bin/zsh
# =============================================================================
#  th-pick – Interaktiver Picker für die Terminal History
#  Navigation mit Cursor-Tasten (↑/↓, PgUp/PgDn, Home/End) oder Mausklick.
#  Tippen filtert, Enter kopiert den Befehl in die Eingabezeile (ohne Ausführen).
#  Neueste Einträge stehen oben.
#
#  Die TUI wird auf /dev/tty geschrieben, der gewählte Befehl auf stdout.
#  Auf Abbruch wird "__TH_NO_SELECT__" ausgegeben.
# =============================================================================

: "${TH_HISTORY_FILE:=$HOME/.terminal_history.jsonl}"
FILE="${1:-$TH_HISTORY_FILE}"
OUTFILE="${2:-}"   # optional: Ergebnisdatei (zusätzlich zu stdout)

[[ -f "$FILE" ]] || { echo "History-Datei nicht gefunden: $FILE" >&2; exit 1; }

# --- TTY für Anzeige (fd 3) und Eingabe (fd 4) öffnen ------------------------
TTY=/dev/tty
# /dev/tty existiert auch ohne Controlling-Terminal -- erst das Öffnen zeigt,
# ob wirklich ein Terminal da ist (z.B. in ": < /dev/tty" scheitert sauber).
if ! { : <"$TTY"; } 2>/dev/null || ! { : >"$TTY"; } 2>/dev/null; then
  echo "th-pick: Kein Terminal (/dev/tty) verfügbar." >&2
  exit 1
fi
exec 3>"$TTY" 2>/dev/null || { echo "th-pick: Kein Terminal verfügbar." >&2; exit 1; }
exec 4<"$TTY" 2>/dev/null || { echo "th-pick: Kein Terminal verfügbar." >&2; exit 1; }

# --- Terminal-Modus sichern; Aufräumen bei Beendigung ------------------------
SAVED_STTY="$(stty -g <"$TTY" 2>/dev/null)"
UI_STARTED=0

cleanup() {
  [[ -n "$SAVED_STTY" ]] && stty "$SAVED_STTY" <"$TTY" 2>/dev/null
  if (( UI_STARTED )); then
    printf '\e[?25h\e[?1000l\e[0m\e[H\e[2J' >&3 2>/dev/null
  fi
  exec 3>&- 2>/dev/null
  exec 4<&- 2>/dev/null
}
trap cleanup EXIT
trap 'exit 130' INT   # explizit beenden, damit keine Endlosschleife entsteht
trap 'exit 143' TERM

# --- Einträge laden ----------------------------------------------------------
# Transportformat: Felder durch \x1f (US), Datensätze durch \x1e (RS) getrennt.
# So bleiben auch mehrzeilige Befehle und Tabs rundtriebfest erhalten.
TMP=$(mktemp -t thpick 2>/dev/null || mktemp)
awk '
function getval(s, key,   i, start, end, c, val, bs, PH) {
  PH = sprintf("%c", 1)   # Platzhalter für escaped Backslashes (\x01)
  i = index(s, "\"" key "\":\"")
  if (i == 0) return ""
  start = i + length(key) + 4
  end = start
  while (end <= length(s)) {
    c = substr(s, end, 1)
    if (c == "\"") {
      # Quote beendet den String nur, wenn sie NICHT escaped ist,
      # also eine gerade Anzahl Backslashes davor steht (\"", \\" beachten).
      bs = 0
      while (substr(s, end - bs - 1, 1) == "\\") bs++
      if (bs % 2 == 0) break
    }
    end++
  }
  val = substr(s, start, end - start)
  gsub(/\\\\/, PH, val)
  gsub(/\\"/, "\"", val)
  gsub(/\\n/, "\n", val)
  gsub(/\\t/, "\t", val)
  gsub(/\\r/, "\r", val)
  gsub(PH, "\\", val)
  return val
}
{
  if ($0 !~ /^\{.*\}$/) next
  id  = getval($0, "id")
  ts  = getval($0, "ts")
  cwd = getval($0, "cwd")
  cmd = getval($0, "cmd")
  printf "%s\037%s\037%s\037%s\036", id, ts, cwd, cmd
}
' "$FILE" > "$TMP"

typeset -a IDS TS CWD CMD
while IFS=$'\x1f' read -r -d $'\x1e' id ts cwd cmd; do
  IDS+=("$id"); TS+=("$ts"); CWD+=("$cwd"); CMD+=("$cmd")
done < "$TMP"
rm -f "$TMP"

TOTAL=${#IDS[@]}
if (( TOTAL == 0 )); then
  printf '__TH_NO_SELECT__\n'
  [[ -n "$OUTFILE" ]] && printf '__TH_NO_SELECT__\n' > "$OUTFILE"
  exit 0
fi

# --- Ergebnis ausgeben -------------------------------------------------------
emit() {
  printf '%s\n' "$1"
  [[ -n "$OUTFILE" ]] && printf '%s\n' "$1" > "$OUTFILE"
}
no_select() { emit '__TH_NO_SELECT__'; }

# --- Terminalgröße -----------------------------------------------------------
get_size() {
  local size
  size="$(stty size <"$TTY" 2>/dev/null)"
  HEIGHT="${size%% *}"
  WIDTH="${size##* }"
  # Degenerierte Werte (z.B. pty ohne Größe) abfangen
  (( HEIGHT < 5 )) && HEIGHT=24
  (( WIDTH < 20 )) && WIDTH=80
}

# --- Filterung (neueste Einträge zuerst) -------------------------------------
typeset -a FILT
filter() {
  FILT=()
  local i
  for ((i=TOTAL; i>=1; i--)); do
    if [[ -z "$query" ]] || [[ "${CMD[$i]}" == *"$query"* ]]; then
      FILT+=($i)
    fi
  done
}

# --- Sichtbarer Fensteranfang ------------------------------------------------
win_start() {
  local rows=$((HEIGHT - 2))
  local s=$((sel - rows + 1))
  (( s < 1 )) && s=1
  echo $s
}

# --- Rendern -----------------------------------------------------------------
render() {
  get_size
  local rows=$((HEIGHT - 2))
  local start=$(win_start)
  local end=$((start + rows - 1))
  (( end > ${#FILT[@]} )) && end=${#FILT[@]}
  local out=""
  out+=$'\e[H\e[2J'
  out+=$'\e[1;36mTerminal History\e[0m  '
  out+=$'\e[2m↑/↓ wählen · Enter kopieren · tippen = suchen · q/Esc = abbrechen\e[0m'
  out+=$'\n'
  local i idx cmdline
  for ((i=start; i<=end; i++)); do
    idx=${FILT[$i]}
    cmdline="${CMD[$idx]}"
    # Mehrzeilige Befehle / Tabs für die EINZEILIGE Anzeige umformen
    cmdline="${cmdline//$'\n'/⏎}"
    cmdline="${cmdline//$'\t'/    }"
    (( ${#cmdline} > WIDTH - 4 )) && cmdline="${cmdline[1,WIDTH-4]}…"
    if (( i == sel )); then
      out+=$'\e[7m'  # reverse video
    fi
    out+="  ${cmdline}"
    out+=$'\e[0m'
    out+=$'\n'
  done
  out+=$'\e[0m'
  out+=$'\e[2m'  # footer
  out+="  ${#FILT[@]} Einträge"
  [[ -n "$query" ]] && out+="  ·  Suche: $query"
  out+=$'\e[0m'
  printf '%s' "$out" >&3
}

# --- Tastendruck lesen -------------------------------------------------------
read_key() {
  local k k2 k3
  read -k1 k <&4 || return 1     # EOF/Fehler -> Abbruchsignal an Hauptschleife
  if [[ "$k" == $'\e' ]]; then
    # Esc-Sequenz oder Esc allein? Kurz auf ein Folge-Byte warten,
    # sonst blockiert das Read und Esc kann nicht abbrechen.
    if read -k1 -t 0.1 k2 <&4; then
      if [[ "$k2" == '[' ]]; then
        read -k1 k3 <&4 || return 1
        if [[ "$k3" == 'M' ]]; then
          # X10-Maus: ESC [ M <btn+32> <col+32> <row+32>
          local b x y
          read -k1 b <&4; read -k1 x <&4; read -k1 y <&4
          echo "MOUSE $(printf '%d' "'$b") $(printf '%d' "'$x") $(printf '%d' "'$y")"
        else
          case "$k3" in
            A) echo UP;;
            B) echo DOWN;;
            C) echo RIGHT;;
            D) echo LEFT;;
            H) echo HOME;;
            F) echo END;;
            '5') read -k1 k3 <&4; echo PGUP;;
            '6') read -k1 k3 <&4; echo PGDN;;
            '3') read -k1 k3 <&4; echo DEL;;
            *) echo IGNORE;;
          esac
        fi
      elif [[ "$k2" == 'O' ]]; then
        read -k1 k3 <&4 || return 1
        case "$k3" in
          H) echo HOME;;
          F) echo END;;
          *) echo IGNORE;;
        esac
      else
        echo IGNORE   # z.B. Alt+Taste
      fi
    else
      echo ESC        # allein gedrücktes Esc
    fi
  elif [[ "$k" == $'\n' || "$k" == $'\r' ]]; then
    echo ENTER
  elif [[ "$k" == $'\x7f' || "$k" == $'\b' ]]; then
    echo BACKSPACE
  elif [[ "$k" == $'\x03' ]]; then
    echo CTRLC
  elif [[ "$k" == $'\x04' ]]; then
    echo CTRLD
  else
    echo "CHAR $k"
  fi
  return 0
}

# --- Hauptschleife -----------------------------------------------------------
query=""
sel=1
filter

# Terminal in passenden Modus versetzen (Echo aus, Zeilenpuffer aus,
# Signaltasten als Bytes liefern, Cursor aus, Maus an)
stty -echo -icanon -isig min 1 time 0 <"$TTY" 2>/dev/null
printf '\e[?25l\e[?1000h' >&3
UI_STARTED=1
render

while true; do
  key=$(read_key) || break   # EOF/Fehler beim Lesen -> beenden
  case "$key" in
    UP)    (( sel > 1 )) && (( sel-- ));;
    DOWN)  (( sel < ${#FILT[@]} )) && (( sel++ ));;
    PGUP)  (( sel -= HEIGHT - 2 )); (( sel < 1 )) && sel=1;;
    PGDN)  (( sel += HEIGHT - 2 ))
           (( sel > ${#FILT[@]} )) && sel=${#FILT[@]}
           (( sel < 1 )) && sel=1;;
    HOME)  sel=1;;
    END)   sel=${#FILT[@]}; (( sel < 1 )) && sel=1;;
    ENTER)
      if (( ${#FILT[@]} > 0 && sel <= ${#FILT[@]} )); then
        emit "${CMD[${FILT[$sel]}]}"
      else
        no_select
      fi
      break;;
    BACKSPACE)
      query="${query[1,-2]}"
      filter
      (( sel > ${#FILT[@]} )) && sel=${#FILT[@]}
      (( sel < 1 )) && sel=1
      ;;
    ESC|CTRLC|CTRLD)
      no_select
      break;;
    MOUSE*)
      set -- ${=key}
      local b=$2 x=$3 y=$4
      if (( b == 32 )) && (( y - 32 >= 2 )); then   # linker Mausklick, nicht auf Kopfzeile
        local start=$(win_start)
        local idx=$(( start + (y - 32) - 2 ))
        if (( idx >= 1 && idx <= ${#FILT[@]} )); then
          sel=$idx
          emit "${CMD[${FILT[$sel]}]}"
          break
        fi
      fi
      ;;
    CHAR*)
      local ch="${key#CHAR }"
      if [[ "$ch" == 'q' && -z "$query" ]]; then
        no_select
        break
      fi
      query+="$ch"
      filter
      (( ${#FILT[@]} > 0 )) && sel=1
      ;;
  esac
  render
done
