#!/bin/zsh
# =============================================================================
#  th-pick - Interactive picker for the terminal history
#  Navigate with arrow keys (↑/↓, PgUp/PgDn, Home/End) or mouse click.
#  Typing filters, Enter copies the command to the command line (no execution).
#  Newest entries on top.
#
#  The TUI is written to /dev/tty, the selected command to stdout.
#  On cancel, "__TH_NO_SELECT__" is printed.
# =============================================================================

: "${TH_HISTORY_FILE:=$HOME/.terminal_history.jsonl}"
FILE="${1:-$TH_HISTORY_FILE}"
OUTFILE="${2:-}"   # optional: result file (in addition to stdout)

[[ -f "$FILE" ]] || { echo "History file not found: $FILE" >&2; exit 1; }

# --- Open TTY for display (fd 3) and input (fd 4) ----------------------------
TTY=/dev/tty
# /dev/tty exists even without a controlling terminal -- only opening it shows
# whether a terminal is really there (": < /dev/tty" fails cleanly otherwise).
if ! { : <"$TTY"; } 2>/dev/null || ! { : >"$TTY"; } 2>/dev/null; then
  echo "th-pick: No terminal (/dev/tty) available." >&2
  exit 1
fi
exec 3>"$TTY" 2>/dev/null || { echo "th-pick: No terminal available." >&2; exit 1; }
exec 4<"$TTY" 2>/dev/null || { echo "th-pick: No terminal available." >&2; exit 1; }

# --- Save terminal mode; clean up on exit -------------------------------------
SAVED_STTY="$(stty -g <"$TTY" 2>/dev/null)"
UI_STARTED=0

cleanup() {
  [[ -n "$SAVED_STTY" ]] && stty "$SAVED_STTY" <"$TTY" 2>/dev/null
  if (( UI_STARTED )); then
    printf '\e[?25h\e[?1000l\e[0m\e[H\e[2J' >&3 2>/dev/null
  fi
  exec 3>&- 2>/dev/null
  exec 4<&- 2>/dev/null
}
trap cleanup EXIT
trap 'exit 130' INT   # exit explicitly so no endless loop can occur
trap 'exit 143' TERM

# --- Load entries ------------------------------------------------------------
# Transport format: fields separated by \x1f (US), records by \x1e (RS).
# This keeps even multi-line commands and tabs round-trip safe.
TMP=$(mktemp -t thpick 2>/dev/null || mktemp)
awk '
function getval(s, key,   i, start, end, c, val, bs, PH) {
  PH = sprintf("%c", 1)   # placeholder for escaped backslashes (\x01)
  i = index(s, "\"" key "\":\"")
  if (i == 0) return ""
  start = i + length(key) + 4
  end = start
  while (end <= length(s)) {
    c = substr(s, end, 1)
    if (c == "\"") {
      # A quote only terminates the string if it is NOT escaped,
      # i.e. preceded by an even number of backslashes (\", \\ matter).
      bs = 0
      while (substr(s, end - bs - 1, 1) == "\\") bs++
      if (bs % 2 == 0) break
    }
    end++
  }
  val = substr(s, start, end - start)
  gsub(/\\\\/, PH, val)
  gsub(/\\"/, "\"", val)
  gsub(/\\n/, "\n", val)
  gsub(/\\t/, "\t", val)
  gsub(/\\r/, "\r", val)
  gsub(PH, "\\", val)
  return val
}
{
  if ($0 !~ /^\{.*\}$/) next
  id  = getval($0, "id")
  ts  = getval($0, "ts")
  cwd = getval($0, "cwd")
  cmd = getval($0, "cmd")
  printf "%s\037%s\037%s\037%s\036", id, ts, cwd, cmd
}
' "$FILE" > "$TMP"

typeset -a IDS TS CWD CMD
while IFS=$'\x1f' read -r -d $'\x1e' id ts cwd cmd; do
  IDS+=("$id"); TS+=("$ts"); CWD+=("$cwd"); CMD+=("$cmd")
done < "$TMP"
rm -f "$TMP"

TOTAL=${#IDS[@]}
if (( TOTAL == 0 )); then
  printf '__TH_NO_SELECT__\n'
  [[ -n "$OUTFILE" ]] && printf '__TH_NO_SELECT__\n' > "$OUTFILE"
  exit 0
fi

# --- Emit result --------------------------------------------------------------
emit() {
  printf '%s\n' "$1"
  [[ -n "$OUTFILE" ]] && printf '%s\n' "$1" > "$OUTFILE"
}
no_select() { emit '__TH_NO_SELECT__'; }

# --- Terminal size -------------------------------------------------------------
get_size() {
  local size
  size="$(stty size <"$TTY" 2>/dev/null)"
  HEIGHT="${size%% *}"
  WIDTH="${size##* }"
  # Guard against degenerate values (e.g. pty without size)
  (( HEIGHT < 5 )) && HEIGHT=24
  (( WIDTH < 20 )) && WIDTH=80
}

# --- Filtering (newest entries first) -----------------------------------------
typeset -a FILT
filter() {
  FILT=()
  local i
  for ((i=TOTAL; i>=1; i--)); do
    if [[ -z "$query" ]] || [[ "${CMD[$i]}" == *"$query"* ]]; then
      FILT+=($i)
    fi
  done
}

# --- Visible window start ------------------------------------------------------
win_start() {
  local rows=$((HEIGHT - 2))
  local s=$((sel - rows + 1))
  (( s < 1 )) && s=1
  echo $s
}

# --- Render --------------------------------------------------------------------
render() {
  get_size
  local rows=$((HEIGHT - 2))
  local start=$(win_start)
  local end=$((start + rows - 1))
  (( end > ${#FILT[@]} )) && end=${#FILT[@]}
  local out=""
  out+=$'\e[H\e[2J'
  out+=$'\e[1;36mTerminal History\e[0m  '
  out+=$'\e[2m↑/↓ select · Enter copy · type = search · q/Esc = cancel\e[0m'
  out+=$'\n'
  local i idx cmdline
  for ((i=start; i<=end; i++)); do
    idx=${FILT[$i]}
    cmdline="${CMD[$idx]}"
    # Reformat multi-line commands / tabs for the SINGLE-LINE display
    cmdline="${cmdline//$'\n'/⏎}"
    cmdline="${cmdline//$'\t'/    }"
    (( ${#cmdline} > WIDTH - 4 )) && cmdline="${cmdline[1,WIDTH-4]}…"
    if (( i == sel )); then
      out+=$'\e[7m'  # reverse video
    fi
    out+="  ${cmdline}"
    out+=$'\e[0m'
    out+=$'\n'
  done
  out+=$'\e[0m'
  out+=$'\e[2m'  # footer
  out+="  ${#FILT[@]} entries"
  [[ -n "$query" ]] && out+="  ·  filter: $query"
  out+=$'\e[0m'
  printf '%s' "$out" >&3
}

# --- Read a keypress -----------------------------------------------------------
read_key() {
  local k k2 k3
  read -k1 k <&4 || return 1     # EOF/error -> cancel signal to main loop
  if [[ "$k" == $'\e' ]]; then
    # Escape sequence or a lone Esc? Wait briefly for a following byte,
    # otherwise the read blocks and Esc cannot cancel.
    if read -k1 -t 0.1 k2 <&4; then
      if [[ "$k2" == '[' ]]; then
        read -k1 k3 <&4 || return 1
        if [[ "$k3" == 'M' ]]; then
          # X10 mouse: ESC [ M <btn+32> <col+32> <row+32>
          local b x y
          read -k1 b <&4; read -k1 x <&4; read -k1 y <&4
          echo "MOUSE $(printf '%d' "'$b") $(printf '%d' "'$x") $(printf '%d' "'$y")"
        else
          case "$k3" in
            A) echo UP;;
            B) echo DOWN;;
            C) echo RIGHT;;
            D) echo LEFT;;
            H) echo HOME;;
            F) echo END;;
            '5') read -k1 k3 <&4; echo PGUP;;
            '6') read -k1 k3 <&4; echo PGDN;;
            '3') read -k1 k3 <&4; echo DEL;;
            *) echo IGNORE;;
          esac
        fi
      elif [[ "$k2" == 'O' ]]; then
        read -k1 k3 <&4 || return 1
        case "$k3" in
          H) echo HOME;;
          F) echo END;;
          *) echo IGNORE;;
        esac
      else
        echo IGNORE   # e.g. Alt+key
      fi
    else
      echo ESC        # Esc pressed alone
    fi
  elif [[ "$k" == $'\n' || "$k" == $'\r' ]]; then
    echo ENTER
  elif [[ "$k" == $'\x7f' || "$k" == $'\b' ]]; then
    echo BACKSPACE
  elif [[ "$k" == $'\x03' ]]; then
    echo CTRLC
  elif [[ "$k" == $'\x04' ]]; then
    echo CTRLD
  else
    echo "CHAR $k"
  fi
  return 0
}

# --- Main loop -----------------------------------------------------------------
query=""
sel=1
filter

# Put terminal into the right mode (echo off, line buffering off,
# signal keys delivered as bytes, cursor hidden, mouse on)
stty -echo -icanon -isig min 1 time 0 <"$TTY" 2>/dev/null
printf '\e[?25l\e[?1000h' >&3
UI_STARTED=1
render

while true; do
  key=$(read_key) || break   # EOF/error while reading -> exit
  case "$key" in
    UP)    (( sel > 1 )) && (( sel-- ));;
    DOWN)  (( sel < ${#FILT[@]} )) && (( sel++ ));;
    PGUP)  (( sel -= HEIGHT - 2 )); (( sel < 1 )) && sel=1;;
    PGDN)  (( sel += HEIGHT - 2 ))
           (( sel > ${#FILT[@]} )) && sel=${#FILT[@]}
           (( sel < 1 )) && sel=1;;
    HOME)  sel=1;;
    END)   sel=${#FILT[@]}; (( sel < 1 )) && sel=1;;
    ENTER)
      if (( ${#FILT[@]} > 0 && sel <= ${#FILT[@]} )); then
        emit "${CMD[${FILT[$sel]}]}"
      else
        no_select
      fi
      break;;
    BACKSPACE)
      query="${query[1,-2]}"
      filter
      (( sel > ${#FILT[@]} )) && sel=${#FILT[@]}
      (( sel < 1 )) && sel=1
      ;;
    ESC|CTRLC|CTRLD)
      no_select
      break;;
    MOUSE*)
      set -- ${=key}
      local b=$2 x=$3 y=$4
      if (( b == 32 )) && (( y - 32 >= 2 )); then   # left mouse click, not on header line
        local start=$(win_start)
        local idx=$(( start + (y - 32) - 2 ))
        if (( idx >= 1 && idx <= ${#FILT[@]} )); then
          sel=$idx
          emit "${CMD[${FILT[$sel]}]}"
          break
        fi
      fi
      ;;
    CHAR*)
      local ch="${key#CHAR }"
      if [[ "$ch" == 'q' && -z "$query" ]]; then
        no_select
        break
      fi
      query+="$ch"
      filter
      (( ${#FILT[@]} > 0 )) && sel=1
      ;;
  esac
  render
done
